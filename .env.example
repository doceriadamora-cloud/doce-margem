# ── Supabase ─────────────────────────────────────────────
# Públicas (frontend): seguras para expor.
# Usadas pelo Auth desde a Fase 4-1B. Se estiverem vazias, o app continua
# funcionando local-first — só a área de conta some do cabeçalho.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas servidor — NUNCA expor no frontend. Ignora RLS.
# Lida por UM único arquivo: services/supabase/admin.ts, importado só pelo
# Route Handler do webhook. Login e cadastro usam a chave anônima, sujeitos
# à RLS. Se esta variável faltar, o webhook recusa a requisição (500) — nunca
# cai para a chave anônima.
SUPABASE_SERVICE_ROLE_KEY=

# ── Webhooks (segredos de validação) ─────────────────────
# KIWIFY_WEBHOOK_SECRET é onde vai o **"token"** que a Kiwify mostra ao cadastrar
# o webhook no painel dela. Nomes diferentes, mesma coisa: o projeto usa
# "_SECRET" para ficar simétrico com Hotmart (DECISIONS.md, 2026-08-06).
# NÃO crie uma KIWIFY_WEBHOOK_TOKEN — dois nomes para um segredo é como um deles
# fica desatualizado em produção sem ninguém notar.
# Se estiver vazia, o webhook responde 500 e não grava nada (falha fechada).
KIWIFY_WEBHOOK_SECRET=
HOTMART_WEBHOOK_SECRET=

# ── Admin ────────────────────────────────────────────────
# Lista de e-mails admin separados por vírgula
ADMIN_EMAILS=

# ── App / links públicos ─────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_BUY_ESSENTIAL_URL=https://pay.kiwify.com.br/seu-checkout
NEXT_PUBLIC_BUY_PRO_ANNUAL_URL=
